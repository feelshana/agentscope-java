  "derived": [
    {
      "table": "project_membership",
      "sql": "SELECT u.user_id, TRIM(jt.membership_raw) AS membership_raw, p.project_id FROM app_user u JOIN JSON_TABLE( CONCAT('[', REPLACE(COALESCE(u.projects_raw, ''), ',', '\",\"'), ']'), '$[*]' COLUMNS(membership_raw VARCHAR(200) PATH '$') ) jt LEFT JOIN project p ON p.project_name = TRIM(jt.membership_raw) WHERE TRIM(jt.membership_raw) <> ''"
    },
    {
      "table": "user_identity",
      "sql": "SELECT account, user_id, 'user_list' AS identity_source FROM app_user UNION SELECT account, CONCAT('unknown:', account) AS user_id, 'unmatched_account' AS identity_source FROM ( SELECT DISTINCT account FROM click_observation UNION SELECT DISTINCT account FROM report_visit ) seen WHERE account NOT IN (SELECT account FROM app_user)"
    },
    {
      "table": "user_object",
      "sql": "SELECT u.user_id, u.account, u.company, u.department, u.position, 'user_list' AS identity_source FROM app_user u UNION ALL SELECT i.user_id, i.account, NULL, NULL, NULL, 'unmatched_account' FROM user_identity i WHERE i.identity_source = 'unmatched_account'"
    },
    {
      "table": "organization",
      "sql": "SELECT CONCAT(COALESCE(company, ''), '|', COALESCE(department, '')) AS org_key, company, department, COUNT(*) AS member_count FROM app_user GROUP BY org_key, company, department"
    },
    {
      "table": "module",
      "sql": "SELECT DISTINCT module_name, product FROM click_observation WHERE module_name IS NOT NULL AND module_name <> ''"
    },
    {
      "table": "report_asset",
      "sql": "SELECT DISTINCT CONCAT(project_name, '|', asset_type, '|', COALESCE(directory, ''), '|', asset_name) AS asset_key, asset_name, directory, asset_type, project_name FROM report_visit WHERE asset_name IS NOT NULL"
    }
  ]
}
