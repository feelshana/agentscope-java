<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!--
      Dedicated file appender for LLM debug logging (DebugLoggingMiddleware). The pattern is
      intentionally bare: the middleware already writes self-describing "role / type / text"
      records and the log is meant to be read by a human, so no timestamp, level or logger name is
      prefixed. Add "%d{yyyy-MM-dd HH:mm:ss.SSS} " back in front of %msg if wall-clock times are
      needed to correlate with the console log.
    -->
    <appender name="LLM_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/LLM.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/LLM.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>200MB</maxFileSize>
            <maxHistory>3</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="LLM_DEBUG" level="INFO" additivity="false">
        <appender-ref ref="LLM_FILE"/>
    </logger>

    <logger name="io.agentscope" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.web" level="WARN"/>
</configuration>
