  "views": [
    {
      "name": "order_net_revenue",
      "sql": "WITH success_refund AS (\n  SELECT\n    order_id,\n    SUM(refund_cents) AS refund_cents\n  FROM refund\n  WHERE refund_status = 'SUCCESS'\n  GROUP BY order_id\n),\nvalid_order AS (\n  SELECT\n    o.order_id AS order_id,\n    o.customer_id AS customer_id,\n    DATE_TRUNC('month', o.order_time) AS order_month,\n    o.amount_cents AS amount_cents\n  FROM order o\n  JOIN customer c ON o.customer_id = c.customer_id\n  WHERE o.status = 'PAID'\n    AND o.is_deleted = 0\n    AND c.is_internal = 0\n)\nSELECT\n  vo.order_id AS order_id,\n  vo.customer_id AS customer_id,\n  vo.order_month AS order_month,\n  vo.amount_cents AS amount_cents,\n  IFNULL(r.refund_cents, 0) AS refund_cents,\n  vo.amount_cents - IFNULL(r.refund_cents, 0) AS net_cents\nFROM valid_order vo\nLEFT JOIN success_refund r ON vo.order_id = r.order_id",
      "description": "净营收视图：以有效订单（PAID + 未删除 + 客户存在且非内部）为基座，先按 order_id 汇总 SUCCESS 退款再左连接（FAILED 不冲减），净额 = 订单金额 - 成功退款金额，退款按原订单月份归属。金额单位为分。",
      "path": "views/order_net_revenue/sql.yml"
    },
    {
      "name": "valid_order",
      "sql": "SELECT\n  o.order_id AS order_id,\n  o.customer_id AS customer_id,\n  o.order_time AS order_time,\n  DATE_TRUNC('month', o.order_time) AS order_month,\n  o.amount_cents AS amount_cents,\n  c.customer_name AS customer_name,\n  c.region AS region\nFROM order o\nJOIN customer c ON o.customer_id = c.customer_id\nWHERE o.status = 'PAID'\n  AND o.is_deleted = 0\n  AND c.is_internal = 0",
      "description": "有效订单口径视图：status=PAID 且未删除，且关联到存在且非内部的客户。金额单位为分，包含订单金额、下单时间与订单月份。未知/空客户不计入。",
      "path": "views/valid_order/sql.yml"
    }
