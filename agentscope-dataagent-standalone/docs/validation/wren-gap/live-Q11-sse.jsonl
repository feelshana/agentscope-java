{"type": "tool_call", "toolName": "wren_run_sql", "toolCallId": "call_00_FhnAMHYRW00ilZtn9dKY2812", "requestId": "4438c73a-f34e-4232-adf3-95936397b702", "runId": "fd6b4b3a-672", "seq": 138, "toolInput": "{\"question\":\"统计订单表中客户为空（customer_id 为 NULL）或客户不存在（无法关联 customer 表）的订单数量\",\"group_id\":\"wren-gap-live-20261006-233059\",\"sql\":\"WITH o AS (\\n  SELECT order_id, customer_id\\n  FROM order\\n)\\nSELECT\\n  COUNT(*) AS total_orders,\\n  SUM(CASE WHEN customer_id IS NULL THEN 1 ELSE 0 END) AS null_customer_orders,\\n  SUM(CASE WHEN customer_id IS NOT NULL AND c.customer_id IS NULL THEN 1 ELSE 0 END) AS unknown_customer_orders,\\n  SUM(CASE WHEN customer_id IS NULL OR c.customer_id IS NULL THEN 1 ELSE 0 END) AS abnormal_orders\\nFROM o\\nLEFT JOIN customer c ON o.customer_id = c.customer_id\"}"}
