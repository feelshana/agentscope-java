target/
node_modules/
logs/
*.iml
.idea/
.flattened-pom.xml

# Runtime shared workspace. Seeded at startup by SharedWorkspaceSeeder from
# src/main/resources/shared (the single source of truth for shipped skills /
# sub-agents) and additionally written to by approved marketplace contributions,
# so its content is per-deployment state rather than source. Anchored with a
# leading slash so src/main/resources/shared stays tracked.
/shared/

# Isolated local acceptance server state, including platform database and logs.
/.tmp-question-acceptance/

# Durable runtime artifacts (back up separately from source).
/data/artifacts/

# Version the project guide even when the parent repository ignores AGENTS.md.
!/AGENTS.md

# Version the Claude Code entry (it imports AGENTS.md) even when the parent ignores CLAUDE.md.
!/CLAUDE.md

# Private deployment profiles contain credentials; Maven also excludes them.
/src/main/resources/application-dev.yml
/src/main/resources/application-prod.yml

# BI simulation keeps the shared key in external, deployment-local configuration.
/docs/integration/bi-simulator.config.json

# Built-in demo files live on the deployment host, never in this public repository.
/data/demo-samples/
