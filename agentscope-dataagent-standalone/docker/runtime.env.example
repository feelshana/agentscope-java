# Copy to private /data/dataagent/runtime.env. Docker env files use raw KEY=value, no shell export.
# Supply real values locally; never commit or share the populated file.
DATAAGENT_PROFILE=prod
DATAAGENT_DB_URL=jdbc:mysql://REPLACE_HOST:3306/dataagent_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DATAAGENT_DB_USER=REPLACE_ME
DATAAGENT_DB_PASSWORD=REPLACE_ME
DATAAGENT_DATASET_DB_URL=jdbc:mysql://REPLACE_HOST:3306/data_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DATAAGENT_DATASET_DB_USER=REPLACE_ME
DATAAGENT_DATASET_DB_PASSWORD=REPLACE_ME
DATAAGENT_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
DATAAGENT_MODEL_ENCRYPTION_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_SECRET
DATAAGENT_CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_BI_ORIGIN
DATAAGENT_BI_ACCOUNT_LOGIN_ENABLED=true
# Add initial model configuration using the exact keys from your private
# application-prod.yml, or configure it through the administrator UI after startup.
